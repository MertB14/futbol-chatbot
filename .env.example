# OpenCode Go API anahtarı (ASLA depoya ekleme)
OPENCODE_API_KEY=buraya-anahtarinizi-yazin
# Base URL ve model kimlikleri OpenCode Go panelinden doğrulanmalı
LLM_BASE_URL=https://opencode.ai/zen/go/v1
# Ana model
LLM_MODEL=gpt-5.6-luna
# Arayüzde seçilebilecek modeller (virgülle ayrılmış, ilki varsayılan).
# Boş bırakılırsa LLM_MODEL, LLM_FALLBACK_MODEL ve LLM_COMPARE_MODELS kullanılır.
LLM_MODELS=gpt-5.6-luna,gemini-4-argon,claude-haiku-5-5
# Yedek model (FR-16); boş bırakılırsa kapalı
LLM_FALLBACK_MODEL=gemini-4-argon
# Düşünen modellerde gizli akıl yürütme seviyesi (none/low/medium/high, "default" = gönderme).
# Yüksek seviye 800 token sınırını doldurup boş/kesik cevaba yol açabilir.
LLM_REASONING_EFFORT=low
# run_tests.py --models varsayılanı (virgülle ayrılmış)
LLM_COMPARE_MODELS=gpt-5.6-luna,gemini-4-argon,claude-haiku-5-5
